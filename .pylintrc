# pylint's settings for Dasha Framework, its tests, and the example applications.
# pylint finds this file by itself when run from this folder, and checks
# the files below, so there "pylint" alone is enough. Files named on the
# command line are checked instead of them.
#
# From apps/ pylint does not find it, so name it and the files there:
#
#     python -m pylint --rcfile=../.pylintrc *.py tests

[MAIN]
# What to check: Dasha Framework, its tests, and the PyInstaller entry point.
files = src,
        tests,
        frozen
# Room for astroid to follow deeply nested code: at Python's default limit
# (1000) it can warn "Some functionality will be missing unless the system
# recursion limit is lifted".
init-hook = import sys; sys.setrecursionlimit(4000)
py-version = 3.12
source-roots = src

[FORMAT]
# Matches black.
max-line-length = 88

[DESIGN]
# Constructors such as Window's and Button's take many keyword-only options.
max-args = 10
# The window and presentation manager classes are the framework's hubs.
max-attributes = 16
max-public-methods = 45
# ctypes structures mirror C structs and have no methods of their own.
exclude-too-few-public-methods = .*ctypes.*Structure,
                                 .*ctypes.*Union
